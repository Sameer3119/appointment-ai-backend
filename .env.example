# ===================================================
# Application Configuration
# ===================================================
PROJECT_NAME="Voice AI Doctor Appointment Assistant"
APP_ENV="development"
DEBUG=True

# Server settings
HOST="127.0.0.1"
PORT=8000

# SQLite Database connection string
DATABASE_URL="sqlite:///./appointments.db"

# Allowed CORS Origins (comma-separated list for frontend access)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ===================================================
# Voice AI Service Credentials & Model Configuration
# ===================================================
# Google Gemini LLM
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Groq LLM
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# ElevenLabs Speech-to-Text & Text-to-Speech
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_STT_MODEL="scribe_v2_realtime"
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"

# Metered.ca TURN Server (optional; required for WebRTC NAT traversal on Render)
METERED_DOMAIN=""
METERED_API_KEY=""
